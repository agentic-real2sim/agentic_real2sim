# Run-time output. No trailing slash so the patterns match both real
# directories AND symlinks (data often lives under
# ~/Research/droid_sim_data/ and is symlinked into the repo).
tmp
artifacts
outputs
raw_episodes

# DROID dataset dir or symlink
droid_data
droid_data/
droid_meta/

# Data dumps (raw FoundationPose outputs etc, large)
media/

# Personal materials (not code)
PPT/
related_paper/
artifacts/
artifacts

# PhysTwin visual model ckpts, etc
ar2s/phystwin_visual/models/weights/
ar2s/phystwin_visual/groundedSAM_checkpoints/
phystwin_visual/models/weights/
phystwin_visual/groundedSAM_checkpoints/

# No trailing slash so this also matches a symlink to
# ~/Research/droid_sim_data/models/
models

# Large transfer artifacts + run outputs (5090 migration). Keep these out of
# git so an accidental `git add .` can't pull in GBs of binaries.
*.tar.gz
*.zip
env_build_situation_5090/
# Phystwin sysid generated outputs (regenerated by run_pipeline)
experiments/
experiments_optimization/
outcmaes/

ar2s/phystwin_visual/models/
phystwin_visual/models/

# build_raw_episode source: the per-episode raw_data/ folder users drop here
# (DROID metadata + cameras json + trajectory + per-cam mp4s). Lives locally
# only; rsynced separately to 5090.
raw_data/

# Local experiment artefacts (PNGs / USDs) emitted by ad-hoc scripts at the
# repo root. Not part of any pipeline output, just scratch space.
out/

# Repo-local symlink to AR2S_CONDA_PATH, used by env install scripts.
.conda
.conda/

# repo-local conda env root created by scripts/setup.sh (AR2S_CONDA_PATH)
.conda_envs/

# Auto-generated by scripts/setup.sh — contains machine-specific paths
# (AR2S_CONDA_PATH / HF_HOME / TORCH_HOME). Each machine writes its own.
scripts/env.sh

# G1 SysID — model weights tracked via Git LFS (see .gitattributes)
# agents_g1sysid/assets/model/*.onnx  <-- tracked by lfs, NOT ignored

# Weights & Biases run directories (created by wandb.init())
wandb/

# Per-batch droid_<N> data dirs (local-only, regenerated by visual +
# sysid for each ~/Research/droid_<N>/ dump). Wildcard covers droid_300,
# droid_400, droid_500, ... without needing edits per new batch. NO
# trailing slash so this also matches symlinks (we frequently keep
# the real data under ~/Research/droid_sim_data/ and symlink it here).
# Files that happen to have `_droid_` in their name
# (install_droid_sim.sh, the Khazatsky PDF,
# upload_pipeline_droid_raw_data_to_ubc.py) are also matched, but they
# already exist as tracked files so git keeps tracking them.
*_droid_*

# legacy/local-only data dirs from older runs
archive/
episodes/
inputs/
raw_episodes/
runs/
